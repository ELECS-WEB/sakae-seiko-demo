---
import { getCollection } from 'astro:content';

const navPages = (await getCollection('pages'))
  .filter((p) => p.data.showInNav)
  .sort((a, b) => a.id.localeCompare(b.id));

const links = [
  { href: '/products/', label: '製品情報' },
  { href: '/news/', label: 'お知らせ' },
  { href: '/cases/', label: '導入事例' },
  ...navPages.map((p) => ({ href: `/${p.id}/`, label: p.data.title })),
];
---

<header class="border-b border-gray-200 bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href="/" class="flex items-baseline gap-2">
      <span class="text-xl font-bold" style="color: var(--brand)">サカエ精工</span>
      <span class="hidden text-xs text-gray-500 sm:inline">SAKAE SEIKO CO., LTD.</span>
    </a>
    <nav>
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm font-medium text-gray-700">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-[var(--brand)]">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
