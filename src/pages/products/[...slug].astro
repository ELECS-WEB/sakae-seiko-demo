---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, formatPrice } from '../../lib/format';

export const getStaticPaths = (async () => {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}) satisfies GetStaticPaths;

const { product } = Astro.props;
const { title, category, model, price, releaseDate, discontinued, tags, thumbnail } = product.data;
const { Content } = await render(product);
---

<BaseLayout title={title}>
  <nav class="mb-6 text-sm text-gray-500">
    <a href="/" class="hover:text-[var(--brand)]">ホーム</a>
    <span class="mx-1">/</span>
    <a href="/products/" class="hover:text-[var(--brand)]">製品情報</a>
    <span class="mx-1">/</span>
    <span class="text-gray-700">{model}</span>
  </nav>

  <div class="grid gap-8 lg:grid-cols-2">
    <div>
      <img src={thumbnail} alt={title} class="w-full rounded-lg border border-gray-200 bg-gray-100" />
    </div>
    <div>
      <div class="flex items-center gap-2">
        <span class="rounded bg-[var(--brand)]/10 px-2 py-0.5 text-xs font-medium text-[var(--brand)]">
          {category}
        </span>
        {
          discontinued && (
            <span class="rounded bg-gray-700 px-2 py-0.5 text-xs font-medium text-white">生産終了</span>
          )
        }
      </div>
      <h1 class="mt-3 text-2xl font-bold text-gray-800">{title}</h1>
      <dl class="mt-5 space-y-2 text-sm">
        <div class="flex gap-3">
          <dt class="w-20 shrink-0 text-gray-500">型番</dt>
          <dd class="font-medium text-gray-800">{model}</dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-20 shrink-0 text-gray-500">価格</dt>
          <dd class="font-semibold text-gray-800">{formatPrice(price)}<span class="ml-1 text-xs font-normal text-gray-400">（税抜）</span></dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-20 shrink-0 text-gray-500">発売日</dt>
          <dd class="text-gray-800">{formatDate(releaseDate)}</dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-20 shrink-0 text-gray-500">タグ</dt>
          <dd class="flex flex-wrap gap-1.5">
            {tags.map((tag) => <span class="rounded bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{tag}</span>)}
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <article class="prose mt-10 max-w-none">
    <Content />
  </article>

  <div class="mt-10">
    <a href="/products/" class="text-sm text-[var(--brand)] hover:underline">← 製品一覧へ戻る</a>
  </div>
</BaseLayout>
