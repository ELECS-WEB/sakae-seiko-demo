---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/format';

export const getStaticPaths = (async () => {
  // 公開フラグが true の事例のみページ生成
  const cases = (await getCollection('cases')).filter((c) => c.data.published);
  const products = await getCollection('products');
  return cases.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, products },
  }));
}) satisfies GetStaticPaths;

const { entry, products } = Astro.props;
const { title, clientName, industry, relatedProducts, publishDate } = entry.data;
const { Content } = await render(entry);

// 型番（model）から製品エントリを引く
const related = relatedProducts
  .map((model) => products.find((p) => p.data.model === model))
  .filter((p) => p !== undefined);
---

<BaseLayout title={title}>
  <nav class="mb-6 text-sm text-gray-500">
    <a href="/" class="hover:text-[var(--brand)]">ホーム</a>
    <span class="mx-1">/</span>
    <a href="/cases/" class="hover:text-[var(--brand)]">導入事例</a>
  </nav>

  <article>
    <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500">
      <span class="rounded bg-[var(--brand)]/10 px-2 py-0.5 text-xs font-medium text-[var(--brand)]">
        {industry}
      </span>
      <time>{formatDate(publishDate)}</time>
    </div>
    <h1 class="mt-3 text-2xl font-bold leading-snug text-gray-800">{title}</h1>
    <p class="mt-2 text-sm text-gray-600">導入企業：{clientName}</p>

    <div class="prose mt-8 max-w-none border-t border-gray-100 pt-8">
      <Content />
    </div>

    {
      related.length > 0 && (
        <section class="mt-10 rounded-lg bg-gray-50 p-5">
          <h2 class="mb-3 text-sm font-bold text-gray-700">この事例で導入された製品</h2>
          <ul class="space-y-1">
            {related.map((product) => (
              <li>
                <a href={`/products/${product.id}/`} class="text-sm text-[var(--brand)] hover:underline">
                  {product.data.model} — {product.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>

  <div class="mt-10">
    <a href="/cases/" class="text-sm text-[var(--brand)] hover:underline">← 導入事例一覧へ戻る</a>
  </div>
</BaseLayout>
