---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/format';

// 公開フラグが true の事例のみ表示
const cases = (await getCollection('cases'))
  .filter((c) => c.data.published)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<BaseLayout title="導入事例">
  <h1 class="mb-2 text-2xl font-bold text-gray-800">導入事例</h1>
  <p class="mb-8 text-sm text-gray-600">
    当社製品をご活用いただいているお客様の事例をご紹介します。（{cases.length} 件）
  </p>

  <div class="grid gap-5 sm:grid-cols-2">
    {
      cases.map((entry) => (
        <a
          href={`/cases/${entry.id}/`}
          class="group flex flex-col rounded-lg border border-gray-200 bg-white p-5 transition-shadow hover:shadow-md"
        >
          <div class="flex items-center gap-2 text-xs text-gray-500">
            <span class="rounded bg-[var(--brand)]/10 px-2 py-0.5 font-medium text-[var(--brand)]">
              {entry.data.industry}
            </span>
            <time>{formatDate(entry.data.publishDate)}</time>
          </div>
          <h2 class="mt-2 flex-1 font-bold leading-snug text-gray-800 group-hover:text-[var(--brand)]">
            {entry.data.title}
          </h2>
          <p class="mt-3 text-sm text-gray-500">{entry.data.clientName}</p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            {entry.data.relatedProducts.map((model) => (
              <span class="rounded bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{model}</span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</BaseLayout>
